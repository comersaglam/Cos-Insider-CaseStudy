# Overrides for the local stack in compose.yaml. Every value already has a default there, so this file is needed
# only to change one: copy it to .env, which git ignores, and edit.
# These credentials are for a local machine only; never reuse them anywhere else.

POSTGRES_USER=notifications
POSTGRES_PASSWORD=notifications
POSTGRES_DB=notifications
POSTGRES_PORT=5432

RABBITMQ_USER=notifications
RABBITMQ_PASSWORD=notifications
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# The API's port on this machine, and the service's log level (debug, info, warn, error).
API_PORT=8080
LOG_LEVEL=info

# The provider the worker sends to. Left out, it is the stand-in in compose.yaml. To send to webhook.site as the
# brief asks, create a URL there, set its response to status 202 with a JSON body, and put it here. A webhook.site URL
# is a credential: anyone who has it can read what is sent to it.
# PROVIDER_URL=https://webhook.site/your-uuid
PROVIDER_PORT=8081

# The worker's operations server (/metrics) on this machine.
WORKER_OPS_PORT=9090

# Jaeger's UI on this machine, where the traces of the API and the worker are read.
JAEGER_UI_PORT=16686
